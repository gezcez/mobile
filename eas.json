{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "node": "22.22.0",
      "bun": "1.4.2",
      "env": { "EXPO_NO_TELEMETRY": "1" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "channel": "e2e",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleRelease" },
      "ios": { "simulator": true },
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_MOCK": "1" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "preview" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "APP_VARIANT": "production" }
    }
  },
  "submit": {
    "preview": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": { "ascAppId": "REPLACE_WITH_ASC_APP_ID" }
    },
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": { "ascAppId": "REPLACE_WITH_ASC_APP_ID" }
    }
  }
}
