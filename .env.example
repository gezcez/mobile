# Copy to .env.local. EXPO_PUBLIC_* values are embedded in the JS bundle: never put secrets here.
# API and OAuth hosts default per APP_VARIANT (app.config.ts); override for a local backend:
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_OAUTH_URL=http://10.0.2.2:5174
# 1 serves every API call and the live feed from local fixtures (src/mock), no backend needed.
EXPO_PUBLIC_MOCK=1
# Sentry is off unless a DSN is set.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only (EAS secrets): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT, EAS_PROJECT_ID, EAS_UPDATE_URL
